{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dayboard-api",
  "main": "src/index.ts",
  "routes": [
    {
      "pattern": "api.dayboard.space",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://dayboard.space",
    "ALLOWED_ORIGINS": "https://dayboard.space",
    "TURNSTILE_HOSTNAMES": "dayboard.space",
    "EMAIL_FROM": "Dayboard <hello@dayboard.space>",
    "EMAIL_REPLY_TO": "support@dayboard.space",
    "SMTP_PORT": "587",
    "SMTP_SECURITY": "starttls"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "SMTP_HOST",
      "SMTP_USERNAME",
      "SMTP_PASSWORD"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dayboard",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
